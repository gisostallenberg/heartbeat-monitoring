{
    "name": "gisostallenberg/heartbeat-monitoring",
    "description": "Adapter-based, DSN-driven heartbeat / cron-job / dead-man's-switch monitoring for healthchecks.io, Uptime Kuma, Pulsetic, Cronitor and Sentry.",
    "type": "library",
    "license": "MIT",
    "keywords": ["heartbeat", "monitoring", "cron", "dead-man-switch", "healthchecks", "cronitor", "sentry", "uptime-kuma", "pulsetic"],
    "require": {
        "php": ">=8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GisoStallenberg\\HeartbeatMonitoring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GisoStallenberg\\HeartbeatMonitoring\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
